# NeoV6 Backend — environment variables
# Copy to .env and fill in. Do NOT commit the real .env.

# --- Required ---
MONGO_URI=                      # MongoDB Atlas connection string
JWT_SECRET=                     # secret for signing/verifying auth JWTs (must match the ML service)
ENCRYPTION_KEY=                 # >= 16 chars; encrypts stored exchange API secrets (REQUIRED — server won't start without it)

# --- ML service link ---
ML_SERVER_URL=http://localhost:8000
INTERNAL_API_KEY=               # shared secret for POST /api/internal/broadcast (must match the ML service)
ML_TLS_INSECURE=false           # set to "true" ONLY for a self-signed dev ML endpoint; never in production

# --- Optional ---
PORT=10000
VITE_API_URL=                   # this backend's own public URL (used by keep-alive)
NEWS_API_KEY=
REDIS_URL=
